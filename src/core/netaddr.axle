// netaddr — an internet address, and the endpoint it makes with a port.
//
//     let a : Addr = Addr::parse("192.168.1.20");
//     a.kind().label()          "private"
//     a.inSubnet(Addr::parse("192.168.0.0"), 16)     true
//     Addr::parse("2001:db8::1").text()              "2001:db8::1"
//
// One class holds both families: sixteen bytes in two numbers, the first half and the second, with the
// family saying how many of them count (an IPv4 address is the last four). Writing an address back as
// text follows RFC 5952 (lower case, the longest run of zero groups shortened to `::`, an IPv4-mapped
// address written with its dotted tail), so two readings of the same address print the same.

use std::text::StringBuilder;
use crate::core::error::Invalid;
use crate::core::ident::Key;
use crate::core::list::Copy;
use crate::core::addrtext::AddrText;

/** What an address is for. */
pub enum AddrKind : i32 {
    /** All zeros: "any", or "none yet". */
    Unspecified = 0,

    /** This machine only. */
    Loopback = 1,

    /** Valid on one link only (169.254/16, fe80::/10). */
    LinkLocal = 2,

    /** Not routed on the internet: 10/8, 172.16/12, 192.168/16, 100.64/10, fc00::/7. */
    Private = 3,

    /** Delivered to a group. */
    Multicast = 4,

    /** Anything else: reachable from the internet. */
    Public = 5,

    /** Its name in a sentence. */
    pub fn label(self) : string {
        return match self {
            AddrKind::Unspecified => "unspecified",
            AddrKind::Loopback => "loopback",
            AddrKind::LinkLocal => "link-local",
            AddrKind::Private => "private",
            AddrKind::Multicast => "multicast",
            AddrKind::Public => "public",
        };
    }

    /** Whether traffic to such an address stays on this machine or its own network. */
    pub fn isInternal(self) : bool {
        return self != AddrKind::Public;
    }
}

/** A run of equal groups in an IPv6 address: where it starts and how long it is. */
struct ZeroRun {
    at  : i32 = -1;
    len : i32 = 0;
}

/** An IPv4 or IPv6 address. */
pub class Addr : Copy<Addr> {
    /** 4 or 6. */
    pub family : i32;
    hi         : i64;
    lo         : i64;

    /**
     * An address of `family` made of its first eight bytes `hi` and its last eight `lo` (an IPv4 address is
     * the last four of `lo`).
     */
    constructor(family : i32, hi : i64, lo : i64) {
        self.family = family;
        self.hi = hi;
        self.lo = lo;
    }

    /** The IPv4 address a.b.c.d. */
    pub static fn v4(a : i32, b : i32, c : i32, d : i32) : Addr {
        return new Addr(
            4,
            0,
            ((a as i64) << 24) | ((b as i64) << 16) | ((c as i64) << 8) | (d as i64)
        );
    }

    /** The IPv4 address whose four bytes, read most significant first, make the number `n`. */
    pub static fn v4n(n : i64) : Addr {
        return new Addr(4, 0, n & 0xFFFFFFFF);
    }

    /** The IPv6 address of the eight 16-bit groups in `g`. */
    pub static fn fromGroups(g : i32[]) : Addr {
        return Addr::v6(
            g[0 as i64],
            g[1 as i64],
            g[2 as i64],
            g[3 as i64],
            g[4 as i64],
            g[5 as i64],
            g[6 as i64],
            g[7 as i64]
        );
    }

    /** The IPv6 address of eight 16-bit groups. */
    pub static fn v6(
        g0 : i32,
        g1 : i32,
        g2 : i32,
        g3 : i32,
        g4 : i32,
        g5 : i32,
        g6 : i32,
        g7 : i32
    ) : Addr {
        let hi : i64 = ((g0 as i64) << 48) | ((g1 as i64) << 32) | ((g2 as i64) << 16) | (g3 as i64);
        let lo : i64 = ((g4 as i64) << 48) | ((g5 as i64) << 32) | ((g6 as i64) << 16) | (g7 as i64);
        return new Addr(6, hi, lo);
    }

    /** 0.0.0.0. */
    pub static fn none() : Addr {
        return new Addr(4, 0, 0);
    }

    /** A separate object with the same address. */
    pub fn copy(self) : Addr {
        return new Addr(self.family, self.hi, self.lo);
    }

    /** Whether this is an IPv4 address. */
    pub fn isV4(self) : bool {
        return self.family == 4;
    }

    /** Whether this is an IPv6 address. */
    pub fn isV6(self) : bool {
        return self.family == 6;
    }

    /** How many bytes it has: 4 or 16. */
    pub fn width(self) : i32 {
        return self.family == 4 ? 4 : 16;
    }

    /** Byte `i` in network order (0 is the first). */
    pub fn byteAt(self, i : i32) : i32 {
        if (self.family == 4) {
            return ((self.lo >> ((3 - i) * 8)) & 255) as i32;
        }
        if (i < 8) {
            return ((self.hi >> ((7 - i) * 8)) & 255) as i32;
        }
        return ((self.lo >> ((15 - i) * 8)) & 255) as i32;
    }

    /** The 16-bit group `g` (0 to 7) of an IPv6 address. */
    pub fn groupAt(self, g : i32) : i32 {
        return (self.byteAt(g * 2) << 8) | self.byteAt(g * 2 + 1);
    }

    /** Whether this is an IPv6 address standing for an IPv4 one (::ffff:a.b.c.d). */
    pub fn isMapped(self) : bool {
        return self.family == 6 && self.hi == 0 && (self.lo >> 32) == 0xFFFF;
    }

    /** The IPv4 address inside an IPv4-mapped IPv6 address; any other address is returned unchanged. */
    pub fn unmapped(self) : Addr {
        if (self.isMapped()) {
            return Addr::v4n(self.lo & 0xFFFFFFFF);
        }
        return self.copy();
    }

    /** Whether it is all zeros. */
    pub fn isUnspecified(self) : bool {
        return self.hi == 0 && self.lo == 0;
    }

    /** What the address is for. */
    pub fn kind(self) : AddrKind {
        if (self.isMapped()) {
            return self.unmapped().kind();
        }
        if (self.isUnspecified()) {
            return AddrKind::Unspecified;
        }
        return self.family == 4 ? self.kindV4() : self.kindV6();
    }

    /** What an IPv4 address is for, from its first two bytes. */
    fn kindV4(self) : AddrKind {
        let a : i32 = self.byteAt(0);
        let b : i32 = self.byteAt(1);
        return match a {
            127 => AddrKind::Loopback,
            169 => b == 254 ? AddrKind::LinkLocal : AddrKind::Public,
            10 => AddrKind::Private,
            172 => b >= 16 && b <= 31 ? AddrKind::Private : AddrKind::Public,
            192 => b == 168 ? AddrKind::Private : AddrKind::Public,
            100 => b >= 64 && b <= 127 ? AddrKind::Private : AddrKind::Public,
            224..=255 => AddrKind::Multicast,
            _ => AddrKind::Public,
        };
    }

    /** What an IPv6 address is for, from its first group. */
    fn kindV6(self) : AddrKind {
        if (self.hi == 0 && self.lo == 1) {
            return AddrKind::Loopback;
        }
        let g0 : i32 = self.groupAt(0);
        if ((g0 & 0xFFC0) == 0xFE80) {
            return AddrKind::LinkLocal;
        }
        if ((g0 & 0xFE00) == 0xFC00) {
            return AddrKind::Private;
        }
        return (g0 & 0xFF00) == 0xFF00 ? AddrKind::Multicast : AddrKind::Public;
    }

    /** Whether `other` is the same address (an IPv4 address and its IPv6-mapped form are the same). */
    pub fn equals(self, other : Addr) : bool {
        let a : Addr = self.unmapped();
        let b : Addr = other.unmapped();
        return a.family == b.family && a.hi == b.hi && a.lo == b.lo;
    }

    /**
     * Whether this address lies in the network `net`/`prefix` (the first `prefix` bits agree). Addresses of
     * different families never do.
     */
    pub fn inSubnet(self, net : Addr, prefix : i32) : bool {
        let a : Addr = self.unmapped();
        let b : Addr = net.unmapped();
        if (a.family != b.family) {
            return false;
        }
        let bits : i32 = prefix < a.width() * 8 ? prefix : a.width() * 8;
        let mut i : i32 = 0;
        while (i * 8 + 8 <= bits) {
            if (a.byteAt(i) != b.byteAt(i)) {
                return false;
            }
            i = i + 1;
        }
        let rest : i32 = bits - i * 8;
        if (rest > 0) {
            let mask : i32 = (255 << (8 - rest)) & 255;
            return (a.byteAt(i) & mask) == (b.byteAt(i) & mask);
        }
        return true;
    }

    /** A number that is the same for the same address across readings. */
    pub fn key(self) : i64 {
        let a : Addr = self.unmapped();
        return Key::step(Key::step(Key::step(Key::seed(), a.family as i64), a.hi), a.lo);
    }

    /** One group in lower-case hexadecimal, without leading zeros. */
    pub(file) static fn hex(sb : StringBuilder, v : i32) : void {
        let digits : string = "0123456789abcdef";
        let mut started : bool = false;
        let mut shift : i32 = 12;
        while (shift >= 0) {
            let d : i32 = (v >> shift) & 15;
            if (d != 0 || started || shift == 0) {
                sb.appendChar(digits.byteAt(d as i64));
                started = true;
            }
            shift = shift - 4;
        }
    }

    /** The dotted form of the last four bytes. */
    pub(file) fn dotted(self, first : i32) : string {
        let mut parts : string[] = malloc<string>(4 as i64);
        for (k of 0..4) {
            parts[k as i64] = self.byteAt(first + k).toString();
        }
        return parts[0 as i64] + "." + parts[1 as i64] + "." + parts[2 as i64] + "." + parts[3 as i64];
    }

    /** The longest run of zero groups (the first, when two tie). */
    fn longestZeroRun(self) : ZeroRun {
        let mut best : ZeroRun = ZeroRun { at: -1, len: 0 };
        let mut at : i32 = 0;
        while (at < 8) {
            let mut end : i32 = at;
            while (end < 8 && self.groupAt(end) == 0) {
                end = end + 1;
            }
            if (end - at > best.len) {
                best = ZeroRun { at: at, len: end - at };
            }
            at = end > at ? end : at + 1;
        }
        return best;
    }

    /** The address as text: dotted for IPv4, RFC 5952 for IPv6. */
    pub fn text(self) : string {
        if (self.family == 4) {
            return self.dotted(0);
        }
        if (self.isMapped()) {
            return "::ffff:" + self.dotted(12);
        }
        let run : ZeroRun = self.longestZeroRun();
        let bestAt : i32 = run.len < 2 ? -1 : run.at;
        let bestLen : i32 = run.len;
        let sb : StringBuilder = new StringBuilder();
        let mut g : i32 = 0;
        while (g < 8) {
            if (g == bestAt) {
                sb.append("::");
                g = g + bestLen;
            } else {
                if (g > 0 && g != bestAt + bestLen) {
                    sb.append(":");
                }
                Addr::hex(sb, self.groupAt(g));
                g = g + 1;
            }
        }
        return sb.toString();
    }

    /** Read an address from text: dotted IPv4, or IPv6 in any of its written forms. */
    pub static fn parse(s : string) : Addr ! Invalid {
        return AddrText::parse(s);
    }
}

/** An address and a port. */
pub class Endpoint {
    /** The address. */
    pub addr : Addr;

    /** The port; 0 when the endpoint has none (a socket not yet connected has remote port 0). */
    pub port : i32;

    /** The endpoint `addr`:`port`. */
    constructor(own addr : Addr, port : i32) {
        self.addr = addr;
        self.port = port;
    }

    /** The endpoint of no address and no port. */
    pub static fn none() : Endpoint {
        return new Endpoint(Addr::none(), 0);
    }

    /** Whether it names nothing: unspecified address, port 0. */
    pub fn isEmpty(self) : bool {
        return self.port == 0 && self.addr.isUnspecified();
    }

    /** `1.2.3.4:80`, or `[::1]:80` for IPv6; just the address when the port is 0. */
    pub fn text(self) : string {
        if (self.port == 0) {
            return self.addr.text();
        }
        if (self.addr.isV6() && !self.addr.isMapped()) {
            return "[" + self.addr.text() + "]:" + self.port.toString();
        }
        return self.addr.unmapped().text() + ":" + self.port.toString();
    }

    /** A number that is the same for the same endpoint across readings. */
    pub fn key(self) : i64 {
        return Key::step(self.addr.key(), self.port as i64);
    }

    /** A separate object with the same address and port. */
    pub fn copy(self) : Endpoint {
        return new Endpoint(self.addr.copy(), self.port);
    }
}
