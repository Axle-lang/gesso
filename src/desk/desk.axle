// desk — what a program can ask of the person's desktop.
//
//     Desk::reveal("C:\\Program Files\\App\\app.exe");     // Explorer opens, the file selected
//
// So far one thing: showing a file where it lives. The notifications, the clipboard and the hotkeys are
// the rest of this module's ground, and wait for a program that needs them.

use crate::core::error::{SysError, Invalid};
use crate::core::privilege::Access;
use crate::core::support::Support;
use crate::core::text::Utf16;
use crate::sys::desksys::DeskSys;
use crate::sys::os::Os;

/** The longest path, in UTF-16 units, that is passed on. */
const PATH_MAX : i32 = 1000;

/** The desktop. */
pub class Desk {
    /**
     * Show the file or folder at `path` in the file manager: on Windows the folder opens with the file
     * selected, on Linux the folder opens. `Gone` when there is no such path (the file manager would
     * otherwise show some other folder and say nothing), `Invalid` for an empty path, a path with a quote in
     * it, or one too long to pass on whole: a path cut short would open another folder and look as if it
     * worked.
     */
    pub static fn reveal(path : string) : void ! SysError {
        Desk::revealUnits(Utf16::units(path));
    }

    /**
     * `reveal` for a path held as UTF-16 code units, as `Procs::imagePathUnits` gives it: exact on Windows
     * even for a path with an unpaired surrogate, which a string cannot hold.
     */
    pub static fn revealUnits(path : i32[]) : void ! SysError {
        let n : i32 = path.length as i32;
        let shown : string = Utf16::decode(path, n < 80 ? n : 80);
        if (n == 0) {
            throw Invalid("desk.reveal", "", "there is no path to show");
        }
        if (n > PATH_MAX) {
            throw Invalid("desk.reveal", shown, "the path is too long to pass on whole");
        }
        for (i of 0..n) {
            if (path[i as i64] == 34 || path[i as i64] == 0) {
                throw Invalid("desk.reveal", shown, "a path cannot hold a quote or a NUL");
            }
        }
        DeskSys::reveal(path);
    }

    /** Whether a file can be shown, so far as it can be known beforehand. */
    pub static fn canReveal() : Support {
        if (Os::name() == "linux") {
            return Support::unknown(
                "it selects the file if the file manager answers on the session bus, else opens its folder"
            );
        }
        return Support::yes();
    }

    /** What kind of operation `reveal` is: it opens a window and changes nothing on the machine. */
    pub static fn revealAccess() : Access {
        return Access::Read;
    }
}
