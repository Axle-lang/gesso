// net — the machine's network: its sockets, its interfaces, its routes, and the questions people ask of them.
//
//     let online : bool = Net::isOnline();
//     let mine : Addr = Net::localAddress();                       // the address traffic leaves from
//     let open : SocketTable = Net::sockets().listening();         // who waits for a connection
//     let theirs : SocketTable = Net::sockets().ofPid(4120).external();
//     let way : RouteInfo = Net::routeTo(Addr::parse("8.8.8.8"));  // and which interface it takes
//
// Everything here only looks (`Access::Read`) and needs no privilege, with one limit that is the system's
// and not this library's: the owner of a socket can be seen for the caller's own processes everywhere,
// and for every process only from an elevated session on Linux (Windows says it to everyone). A socket
// whose owner cannot be seen has `pid` -1; `SocketTable::unowned()` counts them.

use crate::core::error::{SysError, Absent};
use crate::core::netaddr::Addr;
use crate::core::netinfo::{SocketTable, IfaceInfo, IfaceTable, IfaceKind, RouteInfo, RouteTable};
use crate::sys::netsys::NetSys;

/** The network. */
pub class Net {
    /** Every TCP and UDP socket on the machine. */
    pub static fn sockets() : SocketTable ! SysError {
        return NetSys::sockets();
    }

    /** The sockets one process owns. */
    pub static fn socketsOf(pid : i64) : SocketTable ! SysError {
        return NetSys::sockets().ofPid(pid);
    }

    /** Every network interface, with its addresses and its counters. */
    pub static fn interfaces() : IfaceTable ! SysError {
        return NetSys::interfaces();
    }

    /** The routing table. */
    pub static fn routes() : RouteTable ! SysError {
        return NetSys::routes();
    }

    /** The route the system would use to reach `addr`; `Absent` when no route covers it. */
    pub static fn routeTo(addr : Addr) : RouteInfo ! SysError {
        let table : RouteTable = NetSys::routes();
        let at : i32 = table.indexFor(addr);
        if (at < 0) {
            throw Absent("net.routeTo", "route to " + addr.text());
        }
        return table.at(at).copy();
    }

    /** The address of the default gateway (IPv4), or the unspecified address when there is none. */
    pub static fn gateway() : Addr ! SysError {
        return NetSys::routes().defaultGateway(4);
    }

    /** The interface the default IPv4 route leaves by; `Absent` when there is no default route. */
    pub static fn primary() : IfaceInfo ! SysError {
        let routes : RouteTable = NetSys::routes();
        let ifaces : IfaceTable = NetSys::interfaces();
        let r : i32 = routes.defaultIndex(4);
        if (r < 0) {
            throw Absent("net.primary", "default route");
        }
        let mut at : i32 = ifaces.byIndex(routes.at(r).ifIndex);
        if (at < 0) {
            at = ifaces.find(routes.at(r).ifName);
        }
        if (at < 0) {
            throw Absent("net.primary", "interface " + routes.at(r).ifName);
        }
        return ifaces.at(at);
    }

    /**
     * The IPv4 address traffic to the internet leaves from, or the unspecified address when the machine has
     * no way out.
     */
    pub static fn localAddress() : Addr ! SysError {
        try {
            return Net::primary().firstV4();
        } catch e : Absent {
            return Addr::none();
        }
    }

    /**
     * Whether the machine has a default route out through an interface that is up. This is not proof that the
     * internet answers.
     */
    pub static fn isOnline() : bool ! SysError {
        try {
            return Net::primary().up;
        } catch e : Absent {
            return false;
        }
    }

    /**
     * Bytes received and sent by every interface except the loopback, since each came up: (received, sent).
     */
    pub static fn totals() : (rx: i64, tx: i64) ! SysError {
        let ifaces : IfaceTable = NetSys::interfaces();
        let mut rx : i64 = 0;
        let mut tx : i64 = 0;
        for (i of 0..ifaces.size()) {
            if (ifaces.at(i).kind != IfaceKind::Loopback) {
                rx = rx + ifaces.at(i).rxBytes;
                tx = tx + ifaces.at(i).txBytes;
            }
        }
        return (rx, tx);
    }
}
