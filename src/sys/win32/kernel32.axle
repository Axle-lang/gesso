// sys/kernel32 — the kernel32 imports the Windows port uses, and the constants that go with them.
//
// One file for the library's kernel32 imports, because a name can be declared once in a package: the
// seams that need `CloseHandle` or `GetLastError` import it from here rather than declaring it again.
// Each import carries the C signature it stands for, and the arguments that are out-parameters say so.

extern "C" from "kernel32" {
    /** `HANDLE GetCurrentProcess(void)` — a pseudo-handle (-1) that needs no closing. */
    fn GetCurrentProcess() : ptr;

    /** `BOOL CloseHandle(HANDLE)`. */
    fn CloseHandle(h : ptr) : i32;

    /** `DWORD GetLastError(void)`. */
    fn GetLastError() : i32;

    /** `ULONGLONG GetTickCount64(void)` — milliseconds since boot, sleep included. */
    fn GetTickCount64() : i64;

    /**
     * `HANDLE OpenProcess(DWORD access, BOOL inherit, DWORD pid)` — null on failure (87 for an id that does
     * not exist).
     */
    fn OpenProcess(access : i32, inherit : i32, pid : i32) : ptr;

    /**
     * `BOOL QueryFullProcessImageNameW(HANDLE, DWORD flags, LPWSTR name, PDWORD size)` — `size` holds the
     * capacity in code units, then the length.
     */
    fn QueryFullProcessImageNameW(process : ptr, flags : i32, name : ptr, size : ptr) : i32;

    /** `DWORD GetPriorityClass(HANDLE)` — 0 on failure. */
    fn GetPriorityClass(process : ptr) : i32;

    /** `BOOL SetPriorityClass(HANDLE, DWORD class)`. */
    fn SetPriorityClass(process : ptr, cls : i32) : i32;

    /** `BOOL TerminateProcess(HANDLE, UINT exitCode)`. */
    fn TerminateProcess(process : ptr, code : i32) : i32;

    /**
     * `DWORD GetLogicalDriveStringsW(DWORD len, LPWSTR buf)` — "C:\\" NUL "D:\\" NUL NUL; returns the length,
     * or the length needed.
     */
    fn GetLogicalDriveStringsW(len : i32, buf : ptr) : i32;

    /** `UINT GetDriveTypeW(LPCWSTR root)`. */
    fn GetDriveTypeW(root : ptr) : i32;

    /**
     * `BOOL GetVolumeInformationW(root, label, labelLen, serial*, maxComponent*, flags*, fsName, fsNameLen)`.
     */
    fn GetVolumeInformationW(
        root : ptr,
        label : ptr,
        labelLen : i32,
        serial : ptr,
        maxComponent : ptr,
        flags : ptr,
        fsName : ptr,
        fsNameLen : i32
    ) : i32;

    /**
     * `BOOL GetDiskFreeSpaceExW(LPCWSTR dir, PULARGE_INTEGER availableToCaller, PULARGE_INTEGER total,
     * PULARGE_INTEGER totalFree)`.
     */
    fn GetDiskFreeSpaceExW(dir : ptr, available : ptr, total : ptr, unused : ptr) : i32;

    /** `BOOL GetFileAttributesExW(LPCWSTR, GET_FILEEX_INFO_LEVELS, LPVOID WIN32_FILE_ATTRIBUTE_DATA)`. */
    fn GetFileAttributesExW(path : ptr, level : i32, data : ptr) : i32;

    /** `BOOL SetFileAttributesW(LPCWSTR, DWORD)`. */
    fn SetFileAttributesW(path : ptr, attributes : i32) : i32;

    /** `HANDLE FindFirstFileW(LPCWSTR pattern, LPWIN32_FIND_DATAW)` — -1 on failure. */
    fn FindFirstFileW(pattern : ptr, data : ptr) : ptr;

    /** `BOOL FindNextFileW(HANDLE, LPWIN32_FIND_DATAW)`. */
    fn FindNextFileW(h : ptr, data : ptr) : i32;

    /** `BOOL FindClose(HANDLE)`. */
    fn FindClose(h : ptr) : i32;

    /**
     * `BOOLEAN CreateSymbolicLinkW(LPCWSTR link, LPCWSTR target, DWORD flags)` — a BOOLEAN: only the low byte
     * is the answer.
     */
    fn CreateSymbolicLinkW(link : ptr, target : ptr, flags : i32) : i32;

    /** `HANDLE CreateFileW(name, access, share, security, disposition, flags, template)` — -1 on failure. */
    fn CreateFileW(
        name : ptr,
        access : i32,
        share : i32,
        security : ptr,
        disposition : i32,
        flags : i32,
        template : ptr
    ) : ptr;

    /** `BOOL DeviceIoControl(HANDLE, DWORD code, in, inLen, out, outLen, returned*, OVERLAPPED*)`. */
    fn DeviceIoControl(
        h : ptr,
        code : i32,
        input : ptr,
        inputLen : i32,
        output : ptr,
        outputLen : i32,
        returned : ptr,
        overlapped : ptr
    ) : i32;

    /** `HANDLE CreateEventW(security, BOOL manualReset, BOOL initial, LPCWSTR name)`. */
    fn CreateEventW(security : ptr, manualReset : i32, initial : i32, name : ptr) : ptr;

    /** `DWORD WaitForSingleObject(HANDLE, DWORD millis)` — 0 signalled, 258 timed out. */
    fn WaitForSingleObject(h : ptr, millis : i32) : i32;

    /**
     * `BOOL ReadDirectoryChangesW(HANDLE, LPVOID buf, DWORD len, BOOL subtree, DWORD filter, LPDWORD
     * returned, LPOVERLAPPED, completionRoutine)`.
     */
    fn ReadDirectoryChangesW(
        dir : ptr,
        buf : ptr,
        len : i32,
        subtree : i32,
        filter : i32,
        returned : ptr,
        overlapped : ptr,
        routine : ptr
    ) : i32;

    /** `BOOL GetOverlappedResult(HANDLE, LPOVERLAPPED, LPDWORD transferred, BOOL wait)`. */
    fn GetOverlappedResult(h : ptr, overlapped : ptr, transferred : ptr, wait : i32) : i32;

    /** `BOOL CancelIoEx(HANDLE, LPOVERLAPPED)`. */
    fn CancelIoEx(h : ptr, overlapped : ptr) : i32;

    /**
     * `BOOL GetSystemTimes(LPFILETIME idle, LPFILETIME kernel, LPFILETIME user)` — kernel time includes idle
     * time.
     */
    fn GetSystemTimes(idle : ptr, kernel : ptr, user : ptr) : i32;

    /** `BOOL GlobalMemoryStatusEx(LPMEMORYSTATUSEX)` — `dwLength` must be set before the call. */
    fn GlobalMemoryStatusEx(status : ptr) : i32;

    /** `BOOL GetSystemPowerStatus(LPSYSTEM_POWER_STATUS)`. */
    fn GetSystemPowerStatus(status : ptr) : i32;
}

/** `PROCESS_TERMINATE`. */
const PROCESS_TERMINATE : i32 = 0x0001;

/** `PROCESS_SET_INFORMATION` — priority class and affinity. */
const PROCESS_SET_INFORMATION : i32 = 0x0200;

/** `PROCESS_SUSPEND_RESUME`. */
const PROCESS_SUSPEND_RESUME : i32 = 0x0800;

/**
 * `PROCESS_QUERY_LIMITED_INFORMATION` — enough for the image name and the priority class, and granted for
 * most processes an ordinary user cannot fully open.
 */
const PROCESS_QUERY_LIMITED_INFORMATION : i32 = 0x1000;

// ─── Files and volumes ────────────────────────────────────────────

/** File attribute bits. */
const FILE_ATTRIBUTE_READONLY : i32 = 0x1;
const FILE_ATTRIBUTE_HIDDEN : i32 = 0x2;
const FILE_ATTRIBUTE_DIRECTORY : i32 = 0x10;
const FILE_ATTRIBUTE_REPARSE_POINT : i32 = 0x400;

/** `GetDriveTypeW` answers. */
const DRIVE_REMOVABLE : i32 = 2;
const DRIVE_FIXED : i32 = 3;
const DRIVE_REMOTE : i32 = 4;
const DRIVE_CDROM : i32 = 5;
const DRIVE_RAMDISK : i32 = 6;

/**
 * The start of `WIN32_FILE_ATTRIBUTE_DATA` and of `WIN32_FIND_DATAW` is the same: attributes (0), last write
 * time (20), size high (28) and low (32).
 */
const FILEDATA_ATTRIBUTES : i64 = 0;
const FILEDATA_WRITE : i64 = 20;
const FILEDATA_SIZE_HIGH : i64 = 28;
const FILEDATA_SIZE_LOW : i64 = 32;

/** `WIN32_FILE_ATTRIBUTE_DATA` is 36 bytes. */
const FAD_SIZE : i64 = 36;

/** `WIN32_FIND_DATAW` is 592 bytes, with the name at 44 (260 UTF-16 units). */
const FIND_SIZE : i64 = 592;
const FIND_NAME : i64 = 44;

/** 100 ns ticks from 1601-01-01 to 1970-01-01. */
const FILETIME_EPOCH : i64 = 116444736000000000;

/** `CreateFileW` arguments for opening a folder to read its reparse data or watch it. */
const FILE_LIST_DIRECTORY : i32 = 0x1;
const FILE_SHARE_ALL : i32 = 0x7;
const OPEN_EXISTING : i32 = 3;
const FILE_FLAG_BACKUP_SEMANTICS : i32 = 0x02000000;
const FILE_FLAG_OPEN_REPARSE_POINT : i32 = 0x00200000;
const FILE_FLAG_OVERLAPPED : i32 = 0x40000000;

/** `FSCTL_GET_REPARSE_POINT`. */
const FSCTL_GET_REPARSE_POINT : i32 = 0x900A8;

/** `SYMBOLIC_LINK_FLAG_DIRECTORY` and `SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE`. */
const SYMLINK_DIRECTORY : i32 = 0x1;
const SYMLINK_UNPRIVILEGED : i32 = 0x2;

/** `FILE_NOTIFY_CHANGE_*`: file names, folder names, attributes, size, last write. */
const NOTIFY_FILTER : i32 = 0x1F;

/** `WAIT_OBJECT_0` and `WAIT_TIMEOUT`. */
const WAIT_SIGNALLED : i32 = 0;
const WAIT_TIMEOUT : i32 = 258;

/** `OVERLAPPED` (x64, 32 bytes): `hEvent` at 24. */
const OVERLAPPED_SIZE : i64 = 32;
const OVERLAPPED_EVENT : i64 = 24;

/** `FILE_NOTIFY_INFORMATION`: next entry (0), action (4), name length in bytes (8), name (12). */
const FNI_NEXT : i64 = 0;
const FNI_ACTION : i64 = 4;
const FNI_LENGTH : i64 = 8;
const FNI_NAME : i64 = 12;

// ─── Memory ───────────────────────────────────────────

/** `MEMORYSTATUSEX` (64 bytes): `dwLength` (0), `ullTotalPhys` (8), `ullAvailPhys` (16). */
const MEMSTATUS_SIZE : i64 = 64;
const MEMSTATUS_TOTAL : i64 = 8;
const MEMSTATUS_AVAIL : i64 = 16;

// ─── Power ────────────────────────────────────────────

/**
 * `SYSTEM_POWER_STATUS` (12 bytes): `ACLineStatus` (0: 0 offline, 1 online, 255 unknown), `BatteryFlag` (1:
 * 128 no battery, 8 charging, 255 unknown), `BatteryLifePercent` (2: 0 to 100, 255 unknown),
 * `BatteryLifeTime` (4: seconds, 0xFFFFFFFF unknown).
 */
const SPS_SIZE : i64 = 12;
const SPS_AC : i64 = 0;
const SPS_FLAG : i64 = 1;
const SPS_PERCENT : i64 = 2;
const SPS_SECONDS : i64 = 4;

/** `BatteryFlag` bits and the values that mean "not told". */
const BATTERY_CHARGING : i32 = 8;
const BATTERY_NONE : i32 = 128;
const UNKNOWN_BYTE : i32 = 255;
const UNKNOWN_DWORD : i64 = 4294967295;
