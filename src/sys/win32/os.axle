// sys/os — what `std` does not say about the host, on Windows: how long it has been up, and who is asking.
//
// The host's name and its processor count are `std::sys::sysinfo`'s and are not read again
// here; this seam holds what the standard library has no word for.
//
// The privilege reading is the token's own: `TokenElevation` says whether this process runs with a
// full administrator token (under UAC an administrator who has not elevated reads as a plain user, and
// that is the truth about what the process may do), and `TokenUser` against the LocalSystem SID
// (S-1-5-18) says whether it runs as the system itself.

use crate::sys::token::Token;
use crate::core::privilege::Privilege;
use crate::sys::kernel32::{GetTickCount64};

/** What the host is. */
pub class Os {
    /** The platform's name. */
    pub static fn name() : string {
        return "windows";
    }

    /** What separates the parts of a path. */
    pub static fn separator() : string {
        return "\\";
    }

    /** The processor architecture this build runs on. */
    pub static fn arch() : string {
        return "x86_64";
    }

    /** The standing of this process. */
    pub static fn privilege() : Privilege {
        return Token::standing();
    }

    /** Milliseconds since the host started, sleep included. */
    pub static fn uptimeMillis() : i64 {
        return GetTickCount64();
    }
}
